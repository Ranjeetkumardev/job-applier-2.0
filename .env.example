# ── Naukri credentials (only used by global-setup) ─────────
NAUKRI_USERNAME=
NAUKRI_PASSWORD=
NAUKRI_AUTH_STATE=./.auth/naukri.json

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
HEADLESS=false
BROWSER_CHANNEL=chrome
SLOW_MO=100
VIDEO_RECORDING=true

# ── Search defaults ────────────────────────────────────────
JOB_SEARCH_KEYWORDS=MERN Stack Developer
JOB_SEARCH_LOCATION=Noida OR Gurgaon OR Gurugram OR Delhi OR New Delhi
JOB_SEARCH_MIN_EXP=1
JOB_SEARCH_MAX_EXP=4
JOB_SEARCH_JOB_AGE=3

# ── Apply pacing ───────────────────────────────────────────
JOB_APPLY_DELAY_MIN=2000
JOB_APPLY_DELAY_MAX=6000

# ── Storage ────────────────────────────────────────────────
DB_PATH=./storage/applications.db
LOG_LEVEL=info

# ── Optional ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=